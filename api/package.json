{
  "name": "saleshub-api",
  "version": "1.0.2",
  "description": "SalesHub Backend API",
  "type": "module",
  "scripts": {
    "dev": "npx tsx watch server.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:push": "npx prisma db push --schema=./prisma/schema.prisma",
    "db:generate": "npx prisma generate --schema=./prisma/schema.prisma",
    "db:seed": "npx prisma db push --schema=./prisma/schema.prisma --skip-generate && npx tsx prisma/seed.ts",
    "deploy": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy.ps1",
    "deploy:local": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy.ps1 -SkipPush"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "html-pdf-node": "^1.0.8",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
